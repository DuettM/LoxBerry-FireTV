#!/bin/bash
set -u
if [ -z "${LBHOMEDIR:-}" ] && [ -r /etc/environment ]; then . /etc/environment; fi
ROOT="${LBHOMEDIR:-${LBHOME:-/opt/loxberry}}"
DB="$ROOT/data/system/plugindatabase.json"
FOLDER=""
if [ -r "$DB" ]; then
  FOLDER="$(python3 - "$DB" <<'PY'
import json,sys
try:
 d=json.load(open(sys.argv[1],encoding='utf-8'))
 for p in d.get('plugins',[]):
  if p.get('name')=='firetv' and p.get('author_email')=='duett86@web.de':
   print(p.get('folder','')); break
except Exception: pass
PY
)"
fi
[ -n "$FOLDER" ] || FOLDER="firetv"
BIN="$ROOT/bin/plugins/$FOLDER"
CFG="$ROOT/config/plugins/$FOLDER/config.json"
LOG="$ROOT/log/plugins/$FOLDER/mqtt-daemon.log"
[ -x "$BIN/mqtt_listener.py" ] && [ -r "$CFG" ] || exit 0
mkdir -p "$(dirname "$LOG")" 2>/dev/null || true
touch "$LOG" 2>/dev/null || true
chown loxberry:loxberry "$LOG" 2>/dev/null || true
chmod 600 "$LOG" 2>/dev/null || true
if command -v runuser >/dev/null 2>&1; then
  runuser -u loxberry -- "$BIN/mqtt_listener.py" --config "$CFG" --core "$BIN/firetv.py" >>"$LOG" 2>&1 &
elif command -v setpriv >/dev/null 2>&1; then
  setpriv --reuid=loxberry --regid=loxberry --init-groups "$BIN/mqtt_listener.py" --config "$CFG" --core "$BIN/firetv.py" >>"$LOG" 2>&1 &
else
  su -s /bin/sh loxberry -c "exec '$BIN/mqtt_listener.py' --config '$CFG' --core '$BIN/firetv.py'" >>"$LOG" 2>&1 &
fi
exit 0
